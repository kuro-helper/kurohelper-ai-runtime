# Stable SillyTavern image version used by deploy/sillytavern/Dockerfile.
SILLYTAVERN_VERSION=1.18.0

# SillyTavern is published on host loopback only. Use an SSH tunnel or a
# protected reverse proxy if you need remote access.
SILLYTAVERN_PORT=8000
# Shared timezone for Runtime request context, SillyTavern, browser workers,
# and memory maintenance timestamps. Use an IANA timezone name.
TZ=Asia/Taipei
# Trusted Compose subnet used by Podman on this deployment. If the Compose
# network subnet changes, update this list while keeping the SSRF filter on.
ST_PRIVATE_ADDRESS_ALLOWED_RANGES=["127.0.0.0/8","::1/128","10.89.2.0/24"]

# Main role-play generation. The Unicode Gateway uses an OpenAI-compatible
# endpoint and a cgw-prefixed API key. Keep the key private in .env.
CHAT_MODEL=gpt-5.6-luna
CHAT_API_BASE_URL=https://ai-api.aluo.work/v1
CHAT_API_KEY=
# The runtime maps the SillyTavern min/max names to the gateway's
# minimal/xhigh values. Max requests the gateway's highest reasoning effort.
CHAT_REASONING_EFFORT=max
CHAT_SHOW_THOUGHTS=false

# Browser worker readiness. Each failed UI attempt reloads the page; after
# three consecutive session failures the process exits for a container restart.
CONNECTOR_UI_READY_ATTEMPT_MS=20000

# Optional OpenRouter endpoint used only when a workload explicitly selects it.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional OpenRouter-only overrides. They are never sent to the custom chat
# gateway because it does not implement OpenRouter provider routing fields.
OPENROUTER_FORCE_REASONING_EFFORT=
OPENROUTER_PROVIDER_SORT=latency
# Provider metrics are held in memory only until ai-runtime claims them.
METRICS_RECORD_TTL_SECONDS=600
METRICS_MAX_RECORDS=1000

# Discord image understanding. The AI Runtime sends up to four Discord image
# URLs to GPT-5.6 Sol through the chat gateway, then injects the resulting
# guarded description into the role-play prompt as system context.
VISION_ENABLED=true
VISION_API_KEY=
VISION_MODEL=gpt-5.6-luna
VISION_REASONING_EFFORT=max
VISION_PROVIDER_NAME=Unicode Gateway
VISION_MAX_IMAGES=4
VISION_MAX_OUTPUT_TOKENS=500
VISION_TIMEOUT_MS=30000
# Leave empty for the direct chat gateway. OpenRouter route names remain
# supported only as an optional fallback.
VISION_PROVIDER_ROUTES=
VISION_CACHE_ENABLED=true
VISION_CACHE_TTL_SECONDS=86400
VISION_CACHE_MAX_IMAGES=256
VISION_CACHE_MAX_OBSERVATIONS_PER_IMAGE=8
VISION_CACHE_PATH=/data/vision-cache.json

# Character card copied into SillyTavern on the first deployment. The default
# matches this workspace's sibling kuro-character repository.
ST_CHARACTER_CARD_PATH=../../kuro/kuro-character/Kuro-character-card-gpt-5.6-sol/Kuro_chara_card.discord.dedup.png
ST_CHARACTER_CARD_JSON_PATH=../../kuro/kuro-character/Kuro-character-card-gpt-5.6-sol/Kuro_chara_card.discord.dedup.json
ST_CHARACTER_FILE_NAME=Kuro.png
ST_CHARACTER_WORLD_NAME=Kuro
# Inject triggered lore among recent chat messages as a system message so the
# fixed character-card prefix remains cacheable: position 4 = atDepth, role 0 = system.
ST_CHARACTER_LOREBOOK_POSITION=4
ST_CHARACTER_LOREBOOK_DEPTH=4
ST_CHARACTER_LOREBOOK_ROLE=0
ST_DEFAULT_CHARACTER=小黑
ST_DEFAULT_PERSONA=User
ST_UI_LANGUAGE=en

# Optional HTTP Basic Auth for the SillyTavern web page. These values configure
# both SillyTavern and the headless browser through Compose.
ST_BASIC_AUTH_ENABLED=false
ST_BASIC_AUTH_USERNAME=
ST_BASIC_AUTH_PASSWORD=

# Number of isolated SillyTavern pages. Requests stay FIFO inside one Discord
# channel, while different channels can use these workers concurrently.
ST_WORKER_COUNT=3

# Browser worker tuning (milliseconds).
CONNECTOR_UI_TIMEOUT_MS=120000
CONNECTOR_WATCH_INTERVAL_MS=15000

# AI Runtime behavior. These values used to live in server/config.js; they are
# centralized here so deployments do not need to edit application files.
RUNTIME_LOCALE=zh-TW
RUNTIME_USER_LOCALE=zh-TW
RUNTIME_DEBUG=false
# Abort a generation that holds one worker longer than this many seconds.
RUNTIME_QUEUE_TASK_TIMEOUT_SECONDS=60
# Maximum wait for a pending image placeholder before reporting a timeout.
RUNTIME_IMAGE_PLACEHOLDER_TIMEOUT_SECONDS=180
# Recent Discord messages, image observations, and long-term memories share
# this dynamic pool. Memory may use up to the soft budget when space permits.
RUNTIME_DYNAMIC_CONTEXT_TOKEN_BUDGET=1200
RUNTIME_MEMORY_SOFT_TOKEN_BUDGET=400
# Final-only replies avoid Discord edit/delete churn. Dialogue-only mode also
# removes parenthesized or asterisk-delimited stage directions before sending.
RUNTIME_STREAM_RESPONSES=false
RUNTIME_DIALOGUE_ONLY_RESPONSES=true
# Discord IDs remain stable identities; display names become Persona labels.
RUNTIME_AUTO_CREATE_PERSONAS=true
# Stop repeatedly assigning work to unhealthy browser workers.
RUNTIME_CIRCUIT_BREAKER_ENABLED=true
RUNTIME_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
RUNTIME_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# Event-oriented long-term memory. Discord IDs identify event participants,
# channel memories stay local, and only important decisions/summaries may be global.
# Recall is fail-open.
MEMORY_ENABLED=true
MEMORY_RECALL_TIMEOUT_MS=500
MEMORY_CHARACTER_ID=Kuro
MEMORY_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
MEMORY_API_KEY=
MEMORY_EXTRACTION_MODEL=gpt-5.6-luna
MEMORY_EXTRACTION_REASONING_EFFORT=max
MEMORY_EXTRACTION_PROVIDER=Unicode Gateway
MEMORY_MAINTENANCE_INTERVAL_SECONDS=21600
MEMORY_TRASH_RETENTION_DAYS=30
# Create a consistent SQLite snapshot every 24 hours. Startup only fills a missing/stale snapshot.
# Chroma is rebuilt from SQLite after a restore, so it does not need a separate backup.
MEMORY_BACKUP_ENABLED=true
MEMORY_BACKUP_INTERVAL_SECONDS=86400
MEMORY_BACKUP_RETENTION_COUNT=5

# Authenticated connection from the Go kurohelper bot. Run
# `npm run configure-runtime-secret` to generate and synchronize this with
# KURO_RUNTIME_SECRET in kurohelper/.env. The port is bound to host loopback.
KUROHELPER_BRIDGE_SECRET=
KUROHELPER_RUNTIME_PORT=2334
KUROHELPER_REQUEST_CACHE_TTL_SECONDS=600
